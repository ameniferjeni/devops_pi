pipeline {
    agent any

    tools {
        jdk 'JDK17'
        nodejs 'NodeJS20'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '15'))
    }

    triggers {
        githubPush()
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Backend CI') {
            steps {
                dir('backend') {
                    sh 'mvn -B clean verify'
                }
            }
        }

        stage('Business services CI') {
            parallel {
                stage('PFE service') {
                    steps {
                        dir('backend/pfe-service') {
                            sh 'mvn -B verify'
                        }
                    }
                }
                stage('Chatbot service') {
                    steps {
                        dir('backend/chatbot-service') {
                            sh 'mvn -B verify'
                        }
                    }
                }
            }
        }

        stage('Frontend CI') {
            steps {
                dir('frontend') {
                    sh 'npm ci'
                    sh 'npm run build:ci'
                }
            }
        }
    }

    post {
        always {
            junit allowEmptyResults: true, testResults: 'backend/**/target/surefire-reports/*.xml'
        }
        success {
            echo 'CI CodingFactory terminée avec succès.'
        }
        failure {
            echo 'Échec de la CI : consultez le stage en rouge.'
        }
    }
}
