pipeline {
    agent any

    environment {
        EUREKA_HOST_PORT = '8771'
        PFE_HOST_PORT = '8181'
        CHATBOT_HOST_PORT = '8182'
        FRONTEND_HOST_PORT = '8183'
        ML_HOST_PORT = '8184'
        GATEWAY_HOST_PORT = '8190'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '15'))
    }

    triggers {
        githubPush()
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Docker build') {
            steps {
                sh 'docker compose build'
            }
        }

        stage('Deploy') {
            steps {
                sh 'docker compose up -d'
            }
        }

        stage('Smoke tests') {
            steps {
                sh '''
                  set -eu
                  for i in $(seq 1 36); do
                    if curl -sf http://localhost:${PFE_HOST_PORT}/api/pfe/stats >/dev/null; then
                      break
                    fi
                    sleep 5
                  done
                  curl -sf http://localhost:${PFE_HOST_PORT}/api/pfe/stats >/dev/null
                  curl -sf http://localhost:${ML_HOST_PORT}/health >/dev/null
                  curl -sf http://localhost:${FRONTEND_HOST_PORT}/ >/dev/null
                '''
            }
        }
    }

    post {
        failure {
            sh 'docker compose ps || true'
            sh 'docker compose logs --tail=120 || true'
        }
        success {
            echo 'CD CodingFactory terminée : application déployée.'
        }
    }
}
